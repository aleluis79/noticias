{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tts": {
    "Enabled": true,
    "PiperPath": ".tts/piper/piper",
    "ModelPath": ".tts/voices/es_AR-daniela-high.onnx",
    "FfmpegPath": "ffmpeg",
    "EnableMp3": true,
    "CacheDirectory": ".tts/cache",
    "MaxCharacters": 4000,
    "MaxConcurrent": 2
  },
  "Archive": {
    "Directory": ".archive",
    "RetentionDays": 3,
    "TimeZoneId": "America/Argentina/Buenos_Aires"
  }
}
